# Copy to .env and edit. Never commit .env. Placeholders/defaults only - no secrets are required.
# NOTE: the app reads real environment variables; it does not auto-load .env.
# In PowerShell:  $env:MODEL_ARTIFACT_DIR = ".\ml\artifacts\<run_id>\primary"
APP_ENV=development
DATABASE_URL=sqlite:///./fraud_platform.db
MLFLOW_TRACKING_URI=./mlruns
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
REPLAY_SPEED_MULTIPLIER=60

# Backend API
# Folder of ONE trained artifact (contains metadata.json, or a 'primary' subfolder that does). Empty = no model.
MODEL_ARTIFACT_DIR=
# Comma-separated explicit origins. '*' is rejected.
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_UPLOAD_BYTES=5000000
MAX_CSV_ROWS=5000
MAX_JSON_BYTES=16384
MAX_PAGE_SIZE=200
RATE_LIMIT_PREDICT_PER_MIN=60
RATE_LIMIT_BATCH_PER_MIN=6
RATE_LIMIT_READ_PER_MIN=240
# Only set true behind a proxy you control (trusts X-Forwarded-For for rate limiting)
TRUST_PROXY=false
LOG_LEVEL=INFO

# Streaming / monitoring (pass 4)
API_URL=http://127.0.0.1:8000/api/v1
KAFKA_TOPIC=transactions
STREAM_OUTCOMES_DIR=./streaming_outcomes
ARTIFACT_ROOT=./ml/artifacts
MIN_MONITOR_ROWS=100
# Frontend dev proxy target (Vite). The frontend has no secrets; it only calls this API.
VITE_API_PROXY=http://127.0.0.1:8000
